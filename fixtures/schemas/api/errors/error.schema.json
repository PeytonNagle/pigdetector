{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pigdetector.invalid/api/errors/error.schema.json",
  "title": "Error (response)",
  "description": "Every 4xx and 5xx response. message is plain English the web app can show as is.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": { "enum": ["bad_request", "unauthorized", "forbidden", "not_found", "conflict", "internal"] },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
