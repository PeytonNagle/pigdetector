{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pigdetector.invalid/api/history.schema.json",
  "title": "History (response)",
  "description": "GET /nodes/{deviceId}/history?from=&to=&limit=&openings=. Newest first, live and recovered mixed; { items: [] } when no rows are in range.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "description": "A stored message without deviceId and type, plus source.",
        "type": "object",
        "$ref": "../mqtt/state.schema.json#/$defs/status",
        "properties": {
          "source": { "$ref": "../common.schema.json#/$defs/source" },
          "pig": {
            "description": "Door items only: true or false on an opening row (door open, openSec 0), null on every other row.",
            "type": ["boolean", "null"]
          }
        },
        "required": ["source"],
        "if": { "required": ["door"] },
        "then": {
          "required": ["pig"],
          "if": { "properties": { "door": { "const": "open" }, "openSec": { "const": 0 } } },
          "then": { "properties": { "pig": { "type": "boolean" } } },
          "else": { "properties": { "pig": { "type": "null" } } }
        },
        "else": { "properties": { "pig": false } }
      }
    }
  },
  "required": ["items"]
}
