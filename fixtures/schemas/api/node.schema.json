{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pigdetector.invalid/api/node.schema.json",
  "title": "Node (response)",
  "description": "POST /nodes returns this with 201. Also the base of each item in GET /nodes.",
  "$ref": "#/$defs/node",
  "unevaluatedProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "deviceId": { "$ref": "../common.schema.json#/$defs/deviceId" },
        "kind": { "$ref": "../common.schema.json#/$defs/kind" },
        "name": { "$ref": "../common.schema.json#/$defs/name" },
        "createdAt": { "$ref": "../common.schema.json#/$defs/ts" }
      },
      "required": ["deviceId", "kind", "name", "createdAt"]
    }
  }
}
