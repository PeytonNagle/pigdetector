{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pigdetector.invalid/db/node.schema.json",
  "title": "pd_nodes item",
  "description": "One registered node and the user who owns it. Only the API Lambda writes these.",
  "type": "object",
  "properties": {
    "v": {
      "description": "Schema version of this item.",
      "const": 1,
      "default": 1
    },
    "deviceId": { "$ref": "../common.schema.json#/$defs/deviceId" },
    "ownerSub": { "$ref": "../common.schema.json#/$defs/ownerSub" },
    "kind": { "$ref": "../common.schema.json#/$defs/kind" },
    "name": {
      "description": "Label shown on the dashboard, such as \"Fridge door\".",
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "createdAt": { "$ref": "../common.schema.json#/$defs/ts" }
  },
  "required": ["v", "deviceId", "ownerSub", "kind", "name", "createdAt"],
  "additionalProperties": false
}
